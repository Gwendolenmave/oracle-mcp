{
  "mcpServers": {
    "oracle-oci-cloud-mcp-server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "<ABSOLUTE_PATH_TO_FORK>/src/oci-cloud-mcp-server",
        "--frozen",
        "oracle.oci-cloud-mcp-server"
      ],
      "env": {
        "OCI_CONFIG_PROFILE": "AMELIA_OPERATOR",
        "OCI_REGION": "us-ashburn-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
