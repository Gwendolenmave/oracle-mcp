# Copy to /etc/oracle-oci-cloud-mcp.env and replace placeholders.
# Never commit the real file.

ORACLE_MCP_HOST=127.0.0.1
ORACLE_MCP_PORT=8888
ORACLE_MCP_BASE_URL=https://mcp.example.com
OCI_REGION=us-ashburn-1

IDCS_DOMAIN=<identity-domain-hostname-without-https>
IDCS_CLIENT_ID=<confidential-application-client-id>
IDCS_CLIENT_SECRET=<confidential-application-client-secret>
IDCS_AUDIENCE=<identity-propagation-audience>
IDCS_REQUIRED_SCOPES=openid profile email oci_mcp.cloud.invoke

FASTMCP_LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
UV_PROJECT_ENVIRONMENT=/var/lib/oracle-mcp/venv
UV_CACHE_DIR=/var/cache/oracle-mcp

# Convenience values for control recipes only. The upstream generic MCP does
# not read these automatically; do not commit the real values.
VIRGINIA_COMPARTMENT_OCID=<compartment-ocid>
VIRGINIA_INSTANCE_OCID=<instance-ocid>
